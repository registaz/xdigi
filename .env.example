# Copy to .env in the repo root before running `docker-compose up` so the
# backend container picks up your Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_STABLE=gemini-flash-latest
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Human-readable colorized backend logs (set to false for raw JSON lines,
# e.g. when shipping logs to an aggregator).
LOG_PRETTY=true
