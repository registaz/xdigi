# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_assignment?schema=public

# Gemini LLM
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_STABLE=gemini-flash-latest
# Secondary model tried if GEMINI_MODEL_STABLE fails/is unavailable, before
# falling back to deterministic keyword matching.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Logging
# Human-readable colorized console logs (set to false for raw JSON lines,
# e.g. when shipping logs to an aggregator that parses structured JSON).
LOG_PRETTY=true
